# Role: coordinator (HTTP + local worker), dashboard (HTTP only), or worker
NOVA_ROLE=dashboard

# Shared Hyperswarm topic. Change per venue so you do not collide with another team.
NOVA_SWARM_TOPIC=nova-htn-2026

# HTTP data plane (PNG bytes, dashboard, API)
NOVA_HTTP_HOST=0.0.0.0
NOVA_HTTP_PORT=8080

# Control plane: Pear/Hyperswarm discovery plus TCP emergency / LAN path.
NOVA_CONTROL_HOST=0.0.0.0
NOVA_CONTROL_PORT=7946

# Workers: set this if Pear discovery fails. Coordinator prints it on start.
# NOVA_COORDINATOR_URL=http://192.168.x.x:8080
# NOVA_PEERS=192.168.x.x:7946
# Advertised HTTP base for PNG uploads (ngrok / reverse proxy). LAN default otherwise.
# NOVA_PUBLIC_URL=https://xxxx.ngrok-free.app

# Persistent identity + tile store
NOVA_DATA_DIR=.nova

# Model (local files only at demo time)
NOVA_MODEL_ID=stabilityai/sd-turbo
NOVA_MODEL_DIR=models/sd-turbo
# Or point at a downloaded single-file checkpoint:
# NOVA_MODEL_DIR=/Users/you/Downloads/sd_turbo.safetensors
NOVA_KERNEL=sd.t2i.v1

# Use dummy kernel (solid PNGs, no torch) for tests / one-machine rehearsal
NOVA_DUMMY=0
